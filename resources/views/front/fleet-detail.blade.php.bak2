    $multiWordBrands = ['Rolls Royce', 'Rolls-Royce', 'Land Rover', 'Range Rover', 'Aston Martin', 'Mercedes Benz', 'Mercedes-Benz'];
    $brandName = null;
    foreach ($multiWordBrands as $b) {
        if (\Illuminate\Support\Str::startsWith($fleet->name, $b)) { $brandName = $b; break; }
    }
    $brandName = $brandName ?: \Illuminate\Support\Str::before($fleet->name, ' ');
@endphp
